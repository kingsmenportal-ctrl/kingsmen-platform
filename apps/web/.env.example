# Kingsmen web runtime configuration
# Copy to .env.local for local development or configure in the hosting provider.
# The anon key is public by design; enforce all data access with Supabase RLS and
# server-side authorization. Never place service-role keys or payment secrets here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
