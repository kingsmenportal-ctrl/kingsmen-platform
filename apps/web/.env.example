# Server-side Supabase Auth configuration for the Kingsmen web app.
# Set these in the deployment secret/environment settings; never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# The public URL configured in Supabase Auth > URL Configuration must match
# the deployed site. Configure approved redirect URLs before enabling email flows.
# No service-role key is needed or accepted by this authentication boundary.
