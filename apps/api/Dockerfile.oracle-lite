# Kingsmen Oracle Lite backend runtime boundary container preparation.
# This Dockerfile is prepared for a later controlled Docker build proof.
# It does not deploy, submit applications, send email, take payment, or upload documents.

FROM node:22-alpine
WORKDIR /repo
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001
ENV KINGSMEN_ENABLE_LOCAL_BACKEND_WRITE=false
COPY apps/api/src/runtime apps/api/src/runtime
COPY data/local/.gitignore data/local/.gitignore
EXPOSE 3001
CMD ["node", "apps/api/src/runtime/free-destiny-map-backend-local-server.mjs"]
