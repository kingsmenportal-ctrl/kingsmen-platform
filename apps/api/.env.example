# Copy values into your secret manager or local ignored .env file.
# Never commit real credentials or provider keys.

# HTTP listener
PORT=8080
KINGSMEN_API_HOST=0.0.0.0
# Set to the exact trusted frontend origin in deployed environments.
KINGSMEN_API_CORS_ORIGIN=http://localhost:3000

# Persistence
# Production must use PostgreSQL/Supabase persistence; memory mode is local development only.
KINGSMEN_TRUTH_VAULT_MODE=postgres
KINGSMEN_DATABASE_URL=
KINGSMEN_DATABASE_POOL_MAX=8
# Configure only when required by your managed database and certificate setup.
KINGSMEN_DATABASE_SSL=false

# External payment activation remains separately gated.
PAYMENTS_LIVE=false
