# Kingsmen environment example
# Copy to a local .env file or Oracle environment only.
# Do not commit real values. Do not paste secrets into chat, reports, screenshots, or package artifacts.

# Runtime mode
NODE_ENV=development
KINGSMEN_RUNTIME_ENV=local
KINGSMEN_TRUTH_VAULT_MODE=memory
KINGSMEN_DATABASE_SSL=false

# Backend API
KINGSMEN_API_PORT=8080
KINGSMEN_BACKEND_BASE_URL=
KINGSMEN_BACKEND_TIMEOUT_MS=15000

# Truth Vault / queue
DATABASE_URL=
KINGSMEN_DATABASE_URL=
REDIS_URL=

# Email provider. Email is primary, but real provider proof is required before candidate notifications.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=""
SMTP_FROM=

# Payment provider. Sandbox proof is required before paid pilot. Live payments remain disabled until launch gate passes.
PAYMENT_PROVIDER=payfast_sandbox
PAYMENT_PROVIDER_SECRET=""
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX_NOTIFY_URL=
PAYFAST_SANDBOX_RETURN_URL=
PAYFAST_SANDBOX_CANCEL_URL=

# Storage provider for document vault signed uploads.
STORAGE_PROVIDER=
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=
STORAGE_REGION=

# Urgent-only messaging. Not required for core launch.
WHATSAPP_PROVIDER_TOKEN=""
SMS_PROVIDER_TOKEN=""

# Operator helper integrations. Must never expose raw secrets to OpenClaw/Jarvis.
OPENCLAW_GATEWAY_TOKEN=""
GITHUB_TOKEN_FOR_ACTIONS=""
META_BUSINESS_TOKEN=""

# Backup/restore operational paths. Backup archives must stay outside Git.
KINGSMEN_BACKUP_ROOT=
KINGSMEN_RESTORE_DRILL_DATABASE_URL=
