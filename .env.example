# Copy into protected staging settings; never commit real values.
# Local development defaults to memory-only storage. Persistent staging requires postgres mode.
KINGSMEN_TRUTH_VAULT_MODE=memory
KINGSMEN_DATABASE_URL=
DATABASE_URL=
KINGSMEN_API_HOST=0.0.0.0
PORT=8080
KINGSMEN_API_CORS_ORIGIN=http://localhost:3000
# Provider integrations remain mock-only until credentials are configured.
KINGSMEN_PAYFAST_MODE=mock
KINGSMEN_EMAIL_MODE=mock
KINGSMEN_SMS_MODE=mock
KINGSMEN_WHATSAPP_MODE=mock

# Supabase Auth for the Kingsmen web app (public/anon key only; never place service-role keys here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
