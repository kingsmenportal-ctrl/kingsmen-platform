{
  "schema": "kingsmen.secrets-wiring-proof.v1",
  "module": "Secrets Wiring Proof",
  "status": "foundation_built_pending_runtime_secret_health_proof",
  "productionReady": false,
  "publicLaunchAllowed": false,
  "liveSecretsCommitted": false,
  "rawSecretsInReportsAllowed": false,
  "openClawRawSecretAccessAllowed": false,
  "browserServiceRoleAccessAllowed": false,
  "secretValueStorageAllowedInGit": false,
  "requiredRegistry": "manifests/credentials/credentials.registry.json",
  "runtimeEnvExample": ".env.example",
  "allowedSecretLocations": [
    "local_env",
    "github_secret",
    "oracle_env",
    "vault_or_kms_later"
  ],
  "requiredProofScenarios": [
    "credential_registry_exists",
    "credential_entries_have_no_values",
    "required_beta_credentials_named",
    "required_production_credentials_named",
    "runtime_env_example_has_empty_placeholders_only",
    "gitignore_blocks_env_files",
    "gitignore_blocks_private_keys",
    "openclaw_raw_secret_access_false",
    "browser_service_role_access_false",
    "runtime_health_report_masks_presence_only",
    "reports_do_not_include_secret_values",
    "package_artifacts_do_not_include_env_files"
  ],
  "runtimeHealthRules": {
    "printSecretValues": false,
    "printConnectionStrings": false,
    "printTokenPrefixes": false,
    "printKeyLength": false,
    "allowedStatuses": [
      "not_configured",
      "configured_masked",
      "configured_github_secret_unverified",
      "configured_oracle_env_unverified",
      "not_needed_yet"
    ]
  },
  "betaRequiredCredentials": [
    "DATABASE_URL",
    "REDIS_URL"
  ],
  "productionRequiredCredentials": [
    "DATABASE_URL",
    "REDIS_URL",
    "SMTP_HOST",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "PAYMENT_PROVIDER_SECRET",
    "STORAGE_ACCESS_KEY"
  ],
  "evidencePaths": [
    "manifests/credentials/credentials.registry.json",
    "manifests/credentials/secrets-wiring-proof-v1.json",
    ".env.example",
    ".gitignore",
    "docs/security/KINGSMEN_SECRETS_WIRING_PROOF.md",
    "scripts/security/Test-KingsmenSecretWiring.ps1",
    "scripts/proof/prove-secrets-wiring-boundary.mjs",
    "scripts/validators/validate-secrets-wiring-proof.mjs",
    "reports/security/secrets-wiring-proof-latest.json",
    "reports/security/secrets-wiring-validation-latest.json"
  ],
  "remainingConstraint": "Run the runtime secret health check in staging/Oracle with real environment variables configured outside Git; store masked reports only."
}
