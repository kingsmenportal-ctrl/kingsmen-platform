{
  "id": "jarvis-speech-tts-boundary",
  "pj": "PJ42.10",
  "version": "1.0.0",
  "speech_to_text_rules": {
    "transcript_is_draft": true,
    "must_normalize_before_intent_routing": true,
    "must_detect_ambiguity": true,
    "must_not_execute_unclear_command": true,
    "must_show_transcript_for_risky_action": true
  },
  "text_to_speech_rules": {
    "must_use_commander_only_tone": true,
    "must_not_speak_private_raw_data_by_default": true,
    "must_summarize_sensitive_outputs": true,
    "must_state_when_action_is_blocked": true,
    "must_state_when_tool_or_source_failed": true,
    "must_not_claim_success_without_evidence": true
  },
  "streaming_rules": {
    "may_stream_safe_explanations": true,
    "must_not_stream_private_raw_records": true,
    "must_pause_for_approval_when_required": true,
    "tool_use_indicator_required": true,
    "evidence_drawer_must_update_when_tool_finishes": true
  },
  "audio_privacy_rules": {
    "candidate_voice_mode_forbidden": true,
    "public_voice_mode_forbidden": true,
    "finance_private_details_spoken_by_default": false,
    "raw_document_contents_spoken_by_default": false,
    "confirmation_required_before_speaking_sensitive_summary": true
  }
}
