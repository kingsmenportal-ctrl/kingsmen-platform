{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingsmen.local/schemas/jarvis-tool-adapter.schema.json",
  "title": "Jarvis Tool Adapter Schema",
  "type": "object",
  "required": ["id", "pj", "version", "adapters"],
  "properties": {
    "id": { "type": "string" },
    "pj": { "type": "string" },
    "version": { "type": "string" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "adapter_id",
          "label",
          "family",
          "description",
          "allowed_commands",
          "risk_level",
          "approval_required",
          "evidence_required",
          "read_only",
          "live_data_capable",
          "output_surfaces",
          "timeout_ms",
          "failure_fallback"
        ],
        "properties": {
          "adapter_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string" },
          "family": { "type": "string" },
          "description": { "type": "string" },
          "allowed_commands": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
            "minItems": 1
          },
          "risk_level": {
            "type": "string",
            "enum": ["safe_read", "safe_generate", "review_required", "approval_required", "blocked"]
          },
          "approval_required": { "type": "boolean" },
          "evidence_required": { "type": "boolean" },
          "read_only": { "type": "boolean" },
          "live_data_capable": { "type": "boolean" },
          "output_surfaces": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
          "failure_fallback": { "type": "string" },
          "blocked_reason": { "type": "string" },
          "requires_source_confidence": { "type": "boolean" },
          "requires_policy_gate": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
