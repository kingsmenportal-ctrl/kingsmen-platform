{
  "id": "jarvis-hud-state-machine",
  "pj": "PJ42.8",
  "version": "1.0.0",
  "states": [
    "offline",
    "online",
    "ready",
    "listening",
    "thinking",
    "classifying_intent",
    "checking_policy",
    "using_tool",
    "streaming_answer",
    "awaiting_approval",
    "approved",
    "rejected",
    "completed",
    "needs_review",
    "blocked",
    "failed",
    "stale",
    "conflicting"
  ],
  "transitions": [
    { "from": "offline", "to": "online", "event": "jarvis_boot" },
    { "from": "online", "to": "ready", "event": "hud_loaded" },
    { "from": "ready", "to": "listening", "event": "commander_input_started" },
    { "from": "listening", "to": "thinking", "event": "commander_input_received" },
    { "from": "thinking", "to": "classifying_intent", "event": "intent_router_started" },
    { "from": "classifying_intent", "to": "checking_policy", "event": "intent_classified" },
    { "from": "checking_policy", "to": "using_tool", "event": "safe_tool_route_selected" },
    { "from": "checking_policy", "to": "awaiting_approval", "event": "approval_required" },
    { "from": "awaiting_approval", "to": "approved", "event": "commander_approved" },
    { "from": "awaiting_approval", "to": "rejected", "event": "commander_rejected" },
    { "from": "approved", "to": "using_tool", "event": "approved_tool_route_started" },
    { "from": "using_tool", "to": "streaming_answer", "event": "tool_result_ready" },
    { "from": "streaming_answer", "to": "completed", "event": "answer_completed" },
    { "from": "using_tool", "to": "failed", "event": "tool_failed" },
    { "from": "using_tool", "to": "blocked", "event": "tool_blocked" },
    { "from": "streaming_answer", "to": "needs_review", "event": "confidence_requires_review" },
    { "from": "streaming_answer", "to": "stale", "event": "source_stale" },
    { "from": "streaming_answer", "to": "conflicting", "event": "source_conflict_detected" }
  ],
  "terminal_visual_states": ["completed", "needs_review", "blocked", "failed", "stale", "conflicting"],
  "approval_states": ["awaiting_approval", "approved", "rejected"],
  "tool_states": ["using_tool", "failed", "blocked"],
  "display_rule": "Every transition must be visible in the HUD through status text, card state, badge, or timeline entry."
}
