{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingsmen.local/schemas/jarvis-memory-vault.schema.json",
  "title": "Jarvis Memory Vault Schema",
  "type": "object",
  "required": ["id", "pj", "version", "memory_domains"],
  "properties": {
    "id": { "type": "string" },
    "pj": { "type": "string" },
    "version": { "type": "string" },
    "memory_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain_id",
          "label",
          "description",
          "allowed_write_types",
          "blocked_write_types",
          "requires_source_reference",
          "requires_summary_only",
          "retention_class",
          "review_required"
        ],
        "properties": {
          "domain_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "allowed_write_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "blocked_write_types": { "type": "array", "items": { "type": "string" } },
          "requires_source_reference": { "type": "boolean" },
          "requires_summary_only": { "type": "boolean" },
          "retention_class": { "type": "string" },
          "review_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
