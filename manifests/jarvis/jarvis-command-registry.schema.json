{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingsmen.local/schemas/jarvis-command-registry.schema.json",
  "title": "Jarvis Command Registry Schema",
  "type": "object",
  "required": ["id", "pj", "version", "default_unknown_command", "commands"],
  "properties": {
    "id": { "type": "string" },
    "pj": { "type": "string" },
    "version": { "type": "string" },
    "default_unknown_command": { "const": "blocked" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command_id",
          "label",
          "category",
          "description",
          "risk_level",
          "allowed_actor",
          "adapter",
          "approval_required",
          "evidence_required",
          "timeout_ms",
          "output_surface",
          "rollback_note"
        ],
        "properties": {
          "command_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "label": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "risk_level": {
            "type": "string",
            "enum": ["safe_read", "safe_generate", "review_required", "approval_required", "blocked"]
          },
          "allowed_actor": {
            "type": "array",
            "items": { "type": "string", "enum": ["commander", "founder_operator"] },
            "minItems": 1
          },
          "adapter": { "type": "string" },
          "approval_required": { "type": "boolean" },
          "evidence_required": { "type": "boolean" },
          "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
          "output_surface": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "rollback_note": { "type": "string" },
          "blocked_reason": { "type": "string" },
          "requires_live_data": { "type": "boolean" },
          "requires_source_confidence": { "type": "boolean" },
          "requires_commander_review": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
