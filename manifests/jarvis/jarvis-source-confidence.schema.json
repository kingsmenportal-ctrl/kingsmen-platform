{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingsmen.local/schemas/jarvis-source-confidence.schema.json",
  "title": "Jarvis Source Confidence Schema",
  "type": "object",
  "required": ["id", "pj", "version", "confidence_bands"],
  "properties": {
    "id": { "type": "string" },
    "pj": { "type": "string" },
    "version": { "type": "string" },
    "confidence_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "band_id",
          "label",
          "description",
          "may_answer_confidently",
          "may_trigger_action",
          "requires_review",
          "minimum_authority_level",
          "freshness_required_when_current_fact"
        ],
        "properties": {
          "band_id": {
            "type": "string",
            "enum": [
              "verified_official",
              "high_trusted_recent",
              "medium_needs_review",
              "low_unverified_or_stale",
              "blocked_or_unsafe"
            ]
          },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "may_answer_confidently": { "type": "boolean" },
          "may_trigger_action": { "type": "boolean" },
          "requires_review": { "type": "boolean" },
          "minimum_authority_level": { "type": "string" },
          "freshness_required_when_current_fact": { "type": "boolean" },
          "ui_badge": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
