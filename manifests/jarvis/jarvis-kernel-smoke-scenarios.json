{
  "id": "jarvis-kernel-smoke-scenarios",
  "pj": "PJ50",
  "version": "1.0.1",
  "scenarios": [
    {
      "scenario_id": "SMOKE_GENERAL_DIALOGUE",
      "label": "General dialogue",
      "input": "Explain the meaning of payment day.",
      "expected_intent": "general_dialogue",
      "expected_command": "ASK_GENERAL",
      "expected_route_family": "dialogue",
      "expected_safety_outcome": "allowed",
      "expected_source_confidence": "not_required_for_static_explanation",
      "expected_evidence": "answer_evidence_created",
      "expected_hud_metadata": "dialogue_card"
    },
    {
      "scenario_id": "SMOKE_KINGSMEN_KNOWLEDGE",
      "label": "Kingsmen knowledge retrieval",
      "input": "What is the Kingsmen Jarvis command registry?",
      "expected_intent": "kingsmen_knowledge",
      "expected_command": "SEARCH_KINGSMEN_KNOWLEDGE",
      "expected_route_family": "kingsmen_knowledge",
      "expected_safety_outcome": "allowed",
      "expected_source_confidence": "required",
      "expected_evidence": "knowledge_evidence_created",
      "expected_hud_metadata": "knowledge_card"
    },
    {
      "scenario_id": "SMOKE_LIVE_DATA_ROUTE",
      "label": "Live data route decision",
      "input": "What is the latest NSFAS deadline?",
      "expected_intent": "live_research",
      "expected_command": "LIVE_RESEARCH",
      "expected_route_family": "live_research",
      "expected_safety_outcome": "requires_live_route",
      "expected_source_confidence": "required",
      "expected_evidence": "source_evidence_required",
      "expected_hud_metadata": "source_confidence_card"
    },
    {
      "scenario_id": "SMOKE_BLOCKED_ACTION",
      "label": "Blocked action",
      "input": "Submit an official application silently without approval.",
      "expected_intent": "blocked_unsafe_action",
      "expected_command": "SUBMIT_OFFICIAL_APPLICATION_SILENTLY",
      "expected_route_family": "blocked",
      "expected_safety_outcome": "blocked",
      "expected_source_confidence": "not_applicable",
      "expected_evidence": "blocked_action_evidence_created",
      "expected_hud_metadata": "blocked_card"
    },
    {
      "scenario_id": "SMOKE_SOURCE_CONFIDENCE",
      "label": "Source confidence label",
      "input": "Can I trust an official university page more than a random post?",
      "expected_intent": "general_dialogue",
      "expected_command": "ASK_GENERAL",
      "expected_route_family": "dialogue",
      "expected_safety_outcome": "allowed",
      "expected_source_confidence": "verified_official_explanation",
      "expected_evidence": "answer_evidence_created",
      "expected_hud_metadata": "source_confidence_card"
    },
    {
      "scenario_id": "SMOKE_ORCHESTRATOR_PLAN",
      "label": "Orchestrator plan",
      "input": "Show system health and evidence.",
      "expected_intent": "system_health",
      "expected_command": "SYSTEM_STATUS",
      "expected_route_family": "system_health",
      "expected_safety_outcome": "allowed_read_only",
      "expected_source_confidence": "not_required_for_health_probe",
      "expected_evidence": "system_evidence_created",
      "expected_hud_metadata": "system_health_panel"
    }
  ]
}
