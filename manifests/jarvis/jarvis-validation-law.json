    "manifests/jarvis/pj42-1-jarvis-law-master.json",
    "manifests/jarvis/jarvis-permission-law.json",
    "manifests/jarvis/jarvis-memory-law.json",
    "manifests/jarvis/jarvis-live-data-law.json",
    "manifests/jarvis/jarvis-command-risk-law.json",
    "manifests/jarvis/jarvis-visual-hud-law.json",
    "manifests/jarvis/jarvis-evidence-law.json",
    "manifests/jarvis/jarvis-validation-law.json"
  ],
  "required_checks": [
    "files_exist",
    "json_loads",
    "commander_only_rule_present",
    "risk_levels_present",
