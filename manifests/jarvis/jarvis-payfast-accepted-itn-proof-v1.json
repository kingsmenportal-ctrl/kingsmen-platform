{
  "schema": "kingsmen.jarvis-manifest.v1",
  "module": "Jarvis PayFast Accepted ITN Proof Gate",
  "route": "/api/jarvis/payfast-accepted-itn-proof",
  "founderPage": "/founder/launch-control/jarvis-payfast-itn-proof",
  "validator": "scripts/validators/validate-jarvis-payfast-accepted-itn-proof.mjs",
  "productionReady": false,
  "publicLaunchAllowed": false,
  "dockerIndependentBuildAllowed": true,
  "sourceGateBuilt": true,
  "payfastAcceptedItnProofAccepted": false,
  "rules": {
    "returnUrlMayMarkPaid": false,
    "cancelUrlMayMarkPaid": false,
    "acceptedItnRequired": true,
