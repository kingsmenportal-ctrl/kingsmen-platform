# N01.5 - Kingsmen environment template
# Copy this file to .env locally or map these names into your deployment secret manager.
# Do not commit real secrets, service_role keys, SMTP passwords, payment secrets, Airtable tokens, or provider tokens.
# productionReady must remain false until local run + provider health + security audit + interaction proof pass.

# -----------------------------------------------------------------------------
# Core app identity
# -----------------------------------------------------------------------------
KINGSMEN_APP_NAME=kingsmen-platform
KINGSMEN_ENV=local
KINGSMEN_PRODUCTION_READY=false
KINGSMEN_DEFAULT_DEPLOY_TARGET=oracle_lite
KINGSMEN_TIMEZONE=Africa/Johannesburg
KINGSMEN_LOCALE=en-ZA

# Public URLs
KINGSMEN_PUBLIC_BASE_URL=http://localhost:3000
KINGSMEN_API_BASE_URL=http://localhost:4000
KINGSMEN_CONTROL_PLANE_URL=http://localhost:3000/founder/mobile
KINGSMEN_CANDIDATE_PORTAL_URL=http://localhost:3000/candidate/dashboard

# -----------------------------------------------------------------------------
# Oracle Lite / free-tier discipline
# -----------------------------------------------------------------------------
KINGSMEN_ORACLE_LITE_MODE=true
KINGSMEN_DOCKER_COMPOSE_FIRST=true
KINGSMEN_LOW_CONCURRENCY_MODE=true
KINGSMEN_ACTIVE_CANDIDATE_CAP=500
KINGSMEN_READY_CAP_TARGET=1000
KINGSMEN_PREPARE_CAP_TARGET=5000
KINGSMEN_STOP_SELLING_AT_CAP=true
KINGSMEN_WORKER_CONCURRENCY=2
KINGSMEN_PLAYWRIGHT_MAX_CONCURRENCY=1
KINGSMEN_N8N_QUEUE_MODE=true
KINGSMEN_AIRTABLE_MIRROR_INTERVAL_MINUTES=15
KINGSMEN_LOG_RETENTION_DAYS=14
KINGSMEN_REPORT_RETENTION_DAYS=90
KINGSMEN_EVIDENCE_STRUCTURAL_RETENTION=true

# -----------------------------------------------------------------------------
# Communication doctrine
# -----------------------------------------------------------------------------
KINGSMEN_EMAIL_PRIMARY=true
KINGSMEN_WHATSAPP_URGENT_ONLY=true
KINGSMEN_SMS_BACKUP_ONLY=true
KINGSMEN_BULK_WHATSAPP_ALLOWED=false
KINGSMEN_BULK_SMS_ALLOWED=false
KINGSMEN_ROUTINE_WHATSAPP_ALLOWED=false
KINGSMEN_NO_GUARANTEE_LANGUAGE=true
KINGSMEN_PROOF_REQUIRED_BEFORE_STATUS=true
KINGSMEN_SOURCE_VERIFICATION_REQUIRED_FOR_FEES=true
KINGSMEN_SOURCE_VERIFICATION_REQUIRED_FOR_DEADLINES=true

# Email runtime mode
# no_send is the safe default until provider credentials and provider health pass.
EMAIL_PROVIDER=no_send
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Kingsmen Portal
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PROVIDER_HEALTH_REQUIRED=true

# WhatsApp urgent-only provider boundary
WHATSAPP_PROVIDER=disabled
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAMESPACE=
WHATSAPP_URGENT_TEMPLATE_ONLY=true

# SMS backup-only provider boundary
SMS_PROVIDER=disabled
SMS_FROM=
SMS_API_KEY=
SMS_BACKUP_ONLY=true

# -----------------------------------------------------------------------------
# Database and cache
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=postgres
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kingsmen
POSTGRES_USER=kingsmen_app
POSTGRES_PASSWORD=

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_QUEUE_PREFIX=kingsmen

# Supabase optional/free-tier mapping
# SUPABASE_SERVICE_ROLE must be backend/worker-only and never exposed to browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
SUPABASE_STORAGE_BUCKET=kingsmen-documents
SUPABASE_SIGNED_UPLOAD_TTL_SECONDS=900
SUPABASE_RLS_REQUIRED=true

# -----------------------------------------------------------------------------
# Candidate, package, and pricing discipline
# -----------------------------------------------------------------------------
KINGSMEN_ALL_SIX_GATES_VISIBLE=true
KINGSMEN_PACKAGE_CONTROLS_INTENSITY_ONLY=true
KINGSMEN_FOUNDATIONAL_ACCORD_PRICE=169.99
KINGSMEN_COLLEGIATE_ORDINANCE_PRICE=299.99
KINGSMEN_CHANCELLORS_WRIT_PRICE=399.99
KINGSMEN_REGENCY_MANDATE_PRICE=469.99
KINGSMEN_ARTISAN_CHARTER_PRICE=149.99
KINGSMEN_GUILDMASTERS_CHARTER_PRICE=199.99
KINGSMEN_CV_REVAMP_PRICE=49.99
KINGSMEN_CV_REVAMP_UPGRADE_EXTRA_ROUTES=2
KINGSMEN_NSFA_FEE_TASKS_ALLOWED=false
KINGSMEN_CAO_PARENT_APPLICATION_MODEL=true
KINGSMEN_FAST_SUBMISSION_TARGET_MINUTES=60

# -----------------------------------------------------------------------------
# Payments and finance
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=manual_eft_proof
PAYMENT_PROVIDER_HEALTH_REQUIRED=false
PAYMENT_SUCCESS_WEBHOOK_SECRET=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
MANUAL_EFT_ENABLED=true
MANUAL_PAYMENT_PROOF_REVIEW_REQUIRED=true
REFUND_REVIEW_REQUIRED=true

# -----------------------------------------------------------------------------
# Integrations and mirrors
# -----------------------------------------------------------------------------
AIRTABLE_ENABLED=false
AIRTABLE_TOKEN=
AIRTABLE_BASE_NEXUS7=
AIRTABLE_BASE_APPLICATIONS_HUB=
AIRTABLE_BASE_DOCUMENT_VAULT=
AIRTABLE_BASE_COMMS_CENTER=
AIRTABLE_BASE_FINANCIAL_OPERATIONS=
AIRTABLE_BASE_PARTNER_DIRECTORY=
AIRTABLE_MIRROR_ONLY=true

N8N_ENABLED=false
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_THIN_WRAPPER_ONLY=true

PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_SERVICE_URL=http://localhost:4100
PLAYWRIGHT_MAX_CONCURRENCY=1
PLAYWRIGHT_SCOUT_NOT_CRUTCH=true
PLAYWRIGHT_CAPTCHA_BYPASS_ALLOWED=false
PLAYWRIGHT_OTP_BYPASS_ALLOWED=false
PLAYWRIGHT_MAP_FALLBACK_ON_BLOCK=true

# -----------------------------------------------------------------------------
# Privacy, proof, and security
# -----------------------------------------------------------------------------
POPIA_MODE=true
CANDIDATE_CONSENT_REQUIRED_FOR_PARTNER_SHARING=true
SUCCESS_STORY_REQUIRES_PROOF_AND_CONSENT=true
RAW_DOCUMENTS_IN_API_RESPONSES_ALLOWED=false
RAW_EVIDENCE_IN_API_RESPONSES_ALLOWED=false
AUDIT_APPEND_ONLY=true
FOUNDER_MFA_REQUIRED=true
SIGNED_UPLOADS_REQUIRED=true
SERVICE_ROLE_BROWSER_EXPOSURE_ALLOWED=false
SECRETS_IN_GIT_ALLOWED=false

# -----------------------------------------------------------------------------
# Founder operating rhythm and reports
# -----------------------------------------------------------------------------
FOUNDER_MORNING_DIGEST_HOUR=08
FOUNDER_END_OF_DAY_CHECK_HOUR=18
FOUNDER_ACTION_PACKETS_ENABLED=true
FOUNDER_URGENT_ALERTS_ENABLED=true
FOUNDER_STOP_SELLING_ALERTS_ENABLED=true
REPORTS_WRITE_JSON=true
REPORTS_DIRECTORY=reports

# -----------------------------------------------------------------------------
# Local development only
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
WEB_PORT=3000
API_PORT=4000
