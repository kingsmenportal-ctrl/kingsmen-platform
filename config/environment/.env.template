# N01.5 - Kingsmen environment template
# Copy values into your local machine environment or secure deployment settings.
# Do not place real production credentials in Git.

KINGSMEN_APP_NAME=kingsmen-platform
KINGSMEN_ENV=local
KINGSMEN_PRODUCTION_READY=false
KINGSMEN_DEFAULT_DEPLOY_TARGET=oracle_lite
KINGSMEN_PUBLIC_BASE_URL=http://localhost:3000
KINGSMEN_API_BASE_URL=http://localhost:4000
KINGSMEN_TIMEZONE=Africa/Johannesburg

# Runtime discipline
KINGSMEN_ACTIVE_CANDIDATE_CAP=500
KINGSMEN_READY_CAP_TARGET=1000
KINGSMEN_PREPARE_CAP_TARGET=5000
KINGSMEN_LOW_CONCURRENCY_MODE=true
KINGSMEN_EMAIL_PRIMARY=true
KINGSMEN_WHATSAPP_URGENT_ONLY=true
KINGSMEN_SMS_BACKUP_ONLY=true
KINGSMEN_AIRTABLE_MIRROR_ONLY=true
KINGSMEN_PLAYWRIGHT_SCOUT_ONLY=true

# PostgreSQL local development placeholders
PG_HOST=localhost
PG_PORT=5432
PG_DB=kingsmen
PG_USER=kingsmen_app
PG_SSL=false
PG_POOL_MIN=1
PG_POOL_MAX=5

# Redis queue local development placeholders
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_QUEUE_PREFIX=kingsmen
REDIS_WORKER_CONCURRENCY=2

# Supabase public browser-side placeholder only
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-rls-protected-anon-key
SUPABASE_STORAGE_BUCKET_DOCUMENTS=kingsmen-documents
SUPABASE_SIGNED_UPLOAD_TTL_SECONDS=900

# Email runtime starts disabled until provider health is configured
EMAIL_PROVIDER_MODE=disabled
EMAIL_FROM_NAME=Kingsmen Portal
EMAIL_FROM_ADDRESS=no-reply@example.invalid
EMAIL_REPLY_TO=support@example.invalid
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=replace-locally
SMTP_USE_TLS=false
EMAIL_NO_SEND_MODE=true
EMAIL_PREVIEW_MODE=true

# WhatsApp remains urgent-only and disabled until approved templates/provider exist
WHATSAPP_PROVIDER_MODE=disabled
WHATSAPP_URGENT_ONLY=true
WHATSAPP_BULK_BLOCKED=true

# SMS remains backup-only and disabled until provider exists
SMS_PROVIDER_MODE=disabled
SMS_BACKUP_ONLY=true
SMS_BULK_BLOCKED=true

# Payments start with manual proof review / hosted provider abstraction later
PAYMENT_PROVIDER_MODE=manual_proof
PAYMENT_HOSTED_CHECKOUT_ONLY=true
PAYMENT_MANUAL_PROOF_REVIEW_REQUIRED=true
PAYMENT_CURRENCY=ZAR

# Airtable mirror is optional and async-only
AIRTABLE_MIRROR_MODE=disabled
AIRTABLE_SYNC_INTERVAL_MINUTES=15
AIRTABLE_BATCH_LIMIT=25

# Playwright is scout/probe only. Do not bypass OTP/CAPTCHA.
PLAYWRIGHT_MODE=disabled
PLAYWRIGHT_MAX_CONCURRENCY=1
PLAYWRIGHT_BLOCK_ON_CAPTCHA=true
PLAYWRIGHT_BLOCK_ON_OTP=true
PLAYWRIGHT_MAP_FALLBACK_ENABLED=true

# Founder/operator safety
FOUNDER_CONTROL_PLANE_ENABLED=true
FOUNDER_MFA_REQUIRED=true
OPERATOR_MFA_REQUIRED=true
APPEND_ONLY_AUDIT_ENABLED=true
POPIA_ACCESS_LOG_ENABLED=true

# Proof and reports
KINGSMENTRACKER_PATH=Kingsmen_Build_Tracker.csv
KINGSMEN_REPORTS_DIR=reports
KINGSMEN_MANIFESTS_DIR=manifests/modules
KINGSMEN_VALIDATORS_DIR=scripts/validators
KINGSMEN_GIT_REQUIRED=true
