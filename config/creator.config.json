      "reportPath": "reports/creator/creator-validation-report.json"
    },
    {
      "phase": 3,
      "phaseName": "Infrastructure_Gate",
      "modules": ["N01.5", "N01.5.1", "N01.5.2", "N01.6", "N01.6.1", "N01.7", "N01.7.1", "N01.8", "N01.8.1", "N01.9"],
