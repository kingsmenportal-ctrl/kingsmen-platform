  "blockedContent": {
    "hardcodedSecrets": true,
    "supabaseServiceRoleInRepo": true,
    "smtpPasswordInRepo": true,
    "whatsappTokenInRepo": true,
    "paymentSecretInRepo": true,
    "airtableTokenInRepo": true,
    "candidateDocumentsInRepo": true,
