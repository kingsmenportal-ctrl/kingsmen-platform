      "modules": ["UI.1", "UI.1.1", "UI.1.2", "UI.1.3", "UI.2", "UI.2.1", "UI.2.2", "UI.2.3", "UI.3", "UI.3.1", "UI.3.2", "UI.3.3"],
      "status": "not_started"
    }
