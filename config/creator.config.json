{
  "module": "CREATOR",
  "submodule": "CREATOR.4",
  "name": "Kingsmen Creator Configuration",
  "version": "0.1.0",
  "productionReady": false,
  "status": "built_pending_tracker_validation",
  "repo": {
    "name": "kingsmen-platform",
    "owner": "kingsmenportal-ctrl",
    "defaultBranch": "main",
    "rootDetection": ".git",
    "windowsFirst": true,
    "canonicalCreator": "scripts/KINGSMEN_CREATOR.ps1"
  },
  "proofDoctrine": {
    "noClaimWithoutFilePath": true,
    "noFilePathWithoutContent": true,
    "noContentWithoutValidator": true,
    "noValidatorWithoutReport": true,
    "noUiClaimWithoutClickableInteraction": true,
    "noProductionClaimWithoutRuntimeProof": true,
    "trackerIsBuildStatusAuthority": true,
    "chatIsSpecificationNotProof": true,
    "githubCommitIsProofMemory": true
  },
  "actions": {
    "Scaffold": {
      "description": "Create canonical Kingsmen repository directories and .gitkeep placeholders.",
      "allowed": true,
      "writesFiles": true,
      "requiresClipboard": false,
      "safeForFounder": true
    },
    "Materialize": {
      "description": "Read FILE blocks from clipboard and write exact repo files.",
      "allowed": true,
      "writesFiles": true,
      "requiresClipboard": true,
      "fileBlockFormat": "FILE: path/to/file.ext\n---\ncontent\n---",
      "safeForFounder": true
    },
    "Validate": {
      "description": "Run scripts/validators/validate-<module>.mjs for a selected module.",
      "allowed": true,
      "writesFiles": true,
      "requiresModuleName": true,
      "reportRequired": true,
      "safeForFounder": true
    },
    "GitCommit": {
      "description": "Commit and push current repo changes after validation or approved build step.",
      "allowed": true,
      "writesGitHistory": true,
      "requiresCommitMessage": false,
      "safeForFounder": true
    },
    "FullBuild": {
      "description": "Materialize FILE blocks, optionally validate, then commit/push.",
      "allowed": true,
      "writesFiles": true,
      "writesGitHistory": true,
      "requiresClipboard": true,
      "safeForFounder": true
    }
  },
  "phaseRegistry": [
