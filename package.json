{
  "name": "kingsmen-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Kingsmen Platform live build repository",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node scripts/validators/validate-jarvis-core.mjs && node scripts/validators/validate-jarvis-live-pass-02.mjs",
    "jarvis:validate": "node scripts/validators/validate-jarvis-core.mjs && node scripts/validators/validate-jarvis-live-pass-02.mjs",
    "jarvis:validate:core": "node scripts/validators/validate-jarvis-core.mjs",
    "jarvis:validate:live-pass-02": "node scripts/validators/validate-jarvis-live-pass-02.mjs",
    "jarvis:validate:live-pass-03": "node scripts/validators/validate-jarvis-live-pass-03.mjs",
    "jarvis:validate:command-persistence": "node scripts/validators/validate-jarvis-command-truth-vault-persistence.mjs",
    "jarvis:runtime:command-proof": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisCommandRuntimeProof.ps1",
    "jarvis:validate:runtime-command-proof": "node scripts/validators/validate-jarvis-command-runtime-truth-vault-proof.mjs",
    "jarvis:credentials:scan": "powershell -ExecutionPolicy Bypass -File scripts/jarvis/Invoke-JarvisCredentialReadiness.ps1",
    "jarvis:credentials:scan:local": "powershell -ExecutionPolicy Bypass -File scripts/jarvis/Invoke-JarvisCredentialReadiness.ps1 -EnvFile .local/kingsmen.local-postgres.env -BackendBaseUrl http://127.0.0.1:3001",
    "jarvis:runtime:github-tool-boundary": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisGitHubToolConnectorBoundaryProof.ps1",
    "jarvis:validate:github-tool-boundary": "node scripts/validators/validate-jarvis-github-tool-connector-boundary.mjs",
    "jarvis:runtime:airtable-human-mirror": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisAirtableHumanMirrorBoundaryProof.ps1",
    "jarvis:validate:airtable-human-mirror": "node scripts/validators/validate-jarvis-airtable-human-mirror-boundary.mjs",
    "jarvis:runtime:email-primary-channel": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisEmailPrimaryChannelBoundaryProof.ps1",
    "jarvis:validate:email-primary-channel": "node scripts/validators/validate-jarvis-email-primary-channel-boundary.mjs",
    "jarvis:runtime:whatsapp-urgent-sms-backup": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisWhatsAppUrgentSmsBackupBoundaryProof.ps1",
    "jarvis:validate:whatsapp-urgent-sms-backup": "node scripts/validators/validate-jarvis-whatsapp-urgent-sms-backup-boundary.mjs",
    "jarvis:runtime:payfast-provider-proof-queue": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisPayFastProviderProofQueueBoundaryProof.ps1",
    "jarvis:validate:payfast-provider-proof-queue": "node scripts/validators/validate-jarvis-payfast-provider-proof-queue-boundary.mjs",
    "jarvis:runtime:n8n-thin-relay": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisN8nThinRelayBoundaryProof.ps1",
    "jarvis:validate:n8n-thin-relay": "node scripts/validators/validate-jarvis-n8n-thin-relay-boundary.mjs",
    "jarvis:runtime:playwright-scout-map-fallback": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenJarvisPlaywrightScoutMapFallbackBoundaryProof.ps1",
    "jarvis:validate:playwright-scout-map-fallback": "node scripts/validators/validate-jarvis-playwright-scout-map-fallback-boundary.mjs",
    "jarvis:credentials:scan:local:queue": "powershell -ExecutionPolicy Bypass -File scripts/jarvis/Invoke-JarvisCredentialReadiness.ps1 -EnvFile .local/kingsmen.local-postgres.env -BackendBaseUrl http://127.0.0.1:3001 -RedisUrl $env:KINGSMEN_LOCAL_REDIS_URL",
    "jarvis:activation:local:queue": "powershell -ExecutionPolicy Bypass -File scripts/jarvis/Invoke-JarvisLocalQueueActivationMatrix.ps1",
    "jarvis:activation:local:observability": "powershell -ExecutionPolicy Bypass -File scripts/jarvis/Invoke-JarvisLocalObservabilityActivationMatrix.ps1",
    "jarvis:activation:matrix": "powershell -ExecutionPolicy Bypass -File scripts/jarvis/Build-JarvisModuleActivationMatrix.ps1",
    "api:build": "npm --prefix apps/api run build",
    "api:start": "npm --prefix apps/api start",
    "api:start:local": "powershell -ExecutionPolicy Bypass -File scripts/api/Start-KingsmenLocalApi.ps1",
    "api:validate": "npm --prefix apps/api run validate",
    "api:validate:truth-vault": "node scripts/validators/validate-api-truth-vault-persistence.mjs",
    "web:validate:backend-boundary": "node scripts/validators/validate-safe-web-backend-boundary.mjs",
    "payments:prove:sandbox": "node scripts/proof/prove-payfast-sandbox-boundary.mjs",
    "payments:validate:sandbox": "node scripts/validators/validate-payfast-sandbox-proof.mjs",
    "payfast:staging": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenPayFastProviderSandboxStagingProof.ps1",
    "payments:validate:runtime-gate": "node scripts/validators/validate-payfast-runtime-gate-source-only.mjs",
    "payments:validate:http-boundary": "node scripts/validators/validate-payfast-http-boundary.mjs",
    "payments:validate:server-persistence": "node scripts/validators/validate-payfast-server-mount-and-persistence.mjs",
    "payments:validate:service-activation": "node scripts/validators/validate-service-entitlement-activation.mjs",
    "payments:validate:candidate-status": "node scripts/validators/validate-candidate-payment-status.mjs",
    "payments:validate:clean-sync": "node scripts/validators/validate-payfast-clean-sync-carry-forward.mjs",
    "payments:validate:sync-repair": "node scripts/validators/validate-payfast-clean-branch-sync-repair.mjs",
    "repo:sync:payfast-clean": "powershell -ExecutionPolicy Bypass -File scripts/repo/Sync-KingsmenPayFastCleanBranch.ps1",
    "kingsmen:validate:connected-system": "node scripts/validators/validate-kingsmen-connected-operating-system.mjs",
    "founder:validate:control-plane": "node scripts/validators/validate-founder-control-plane.mjs",
    "security:prove:rls": "node scripts/proof/prove-rls-security-boundary.mjs",
    "security:validate:rls": "node scripts/validators/validate-rls-security-proof.mjs",
    "backup:prove:restore": "node scripts/proof/prove-backup-restore-boundary.mjs",
    "backup:validate:restore": "node scripts/validators/validate-backup-restore-proof.mjs",
    "repo:prove:branch-protection": "node scripts/proof/prove-main-branch-protection-boundary.mjs",
    "repo:validate:branch-protection": "node scripts/validators/validate-main-branch-protection.mjs",
    "secrets:prove:wiring": "node scripts/proof/prove-secrets-wiring-boundary.mjs",
    "secrets:validate:wiring": "node scripts/validators/validate-secrets-wiring-proof.mjs",
    "communications:prove": "node scripts/proof/prove-communications-boundary.mjs",
    "communications:validate": "node scripts/validators/validate-communications-proof.mjs",
    "communications:staging": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenCommunicationsProviderStagingProof.ps1",
    "observability:prove": "node scripts/proof/prove-observability-incident-boundary.mjs",
    "observability:validate": "node scripts/validators/validate-observability-incident-proof.mjs",
    "observability:staging": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenObservabilityIncidentStagingProof.ps1",
    "legal:prove": "node scripts/proof/prove-legal-privacy-boundary.mjs",
    "legal:validate": "node scripts/validators/validate-legal-privacy-proof.mjs",
    "legal:staging": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenLegalPrivacyPublicationProof.ps1",
    "document-vault:staging": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenDocumentVaultStorageStagingProof.ps1",
    "staging:prove:pack": "node scripts/proof/prove-staging-runtime-proof-pack.mjs",
    "staging:validate:pack": "node scripts/validators/validate-staging-runtime-proof-pack.mjs",
    "staging:prove:capture": "node scripts/proof/prove-staging-runtime-evidence-capture.mjs",
    "staging:validate:capture": "node scripts/validators/validate-staging-runtime-evidence-capture.mjs",
    "staging:capture:evidence": "powershell -ExecutionPolicy Bypass -File scripts/staging/Invoke-KingsmenStagingRuntimeEvidencePack.ps1",
    "final:prove:evidence": "node scripts/proof/prove-final-assembly-evidence-capture.mjs",
    "final:validate:evidence": "node scripts/validators/validate-final-assembly-evidence-capture.mjs",
    "final:collect:evidence": "powershell -ExecutionPolicy Bypass -File scripts/staging/Collect-KingsmenFinalAssemblyEvidence.ps1",
    "kingsmen:launch:audit": "node scripts/validators/validate-kingsmen-launch-readiness.mjs --audit",
    "kingsmen:launch:gate": "node scripts/validators/validate-kingsmen-launch-readiness.mjs --gate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsmenportal-ctrl/kingsmen-platform.git"
  },
  "keywords": [
    "kingsmen",
    "jarvis",
    "south-africa"
  ],
  "license": "UNLICENSED"
}
