{
  "name": "kingsmen-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Kingsmen Platform live build repository",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node scripts/validators/validate-jarvis-core.mjs && node scripts/validators/validate-jarvis-live-pass-02.mjs",
    "jarvis:validate": "node scripts/validators/validate-jarvis-core.mjs && node scripts/validators/validate-jarvis-live-pass-02.mjs",
    "jarvis:validate:core": "node scripts/validators/validate-jarvis-core.mjs",
    "jarvis:validate:live-pass-02": "node scripts/validators/validate-jarvis-live-pass-02.mjs",
    "jarvis:validate:live-pass-03": "node scripts/validators/validate-jarvis-live-pass-03.mjs",
    "api:build": "npm --prefix apps/api run build",
    "api:start": "npm --prefix apps/api start",
    "api:validate": "npm --prefix apps/api run validate",
    "api:validate:truth-vault": "node scripts/validators/validate-api-truth-vault-persistence.mjs",
    "web:validate:backend-boundary": "node scripts/validators/validate-safe-web-backend-boundary.mjs",
    "payments:prove:sandbox": "node scripts/proof/prove-payfast-sandbox-boundary.mjs",
    "payments:validate:sandbox": "node scripts/validators/validate-payfast-sandbox-proof.mjs",
    "security:prove:rls": "node scripts/proof/prove-rls-security-boundary.mjs",
    "security:validate:rls": "node scripts/validators/validate-rls-security-proof.mjs",
    "backup:prove:restore": "node scripts/proof/prove-backup-restore-boundary.mjs",
    "backup:validate:restore": "node scripts/validators/validate-backup-restore-proof.mjs",
    "repo:prove:branch-protection": "node scripts/proof/prove-main-branch-protection-boundary.mjs",
    "repo:validate:branch-protection": "node scripts/validators/validate-main-branch-protection.mjs",
    "secrets:prove:wiring": "node scripts/proof/prove-secrets-wiring-boundary.mjs",
    "secrets:validate:wiring": "node scripts/validators/validate-secrets-wiring-proof.mjs",
    "kingsmen:launch:audit": "node scripts/validators/validate-kingsmen-launch-readiness.mjs --audit",
    "kingsmen:launch:gate": "node scripts/validators/validate-kingsmen-launch-readiness.mjs --gate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsmenportal-ctrl/kingsmen-platform.git"
  },
  "keywords": [
    "kingsmen",
    "jarvis",
    "south-africa",
    "admissions",
    "opportunities"
  ],
  "author": "Kingsmen Portal",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/kingsmenportal-ctrl/kingsmen-platform/issues"
  },
  "homepage": "https://github.com/kingsmenportal-ctrl/kingsmen-platform#readme",
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^6.0.3"
  }
}
